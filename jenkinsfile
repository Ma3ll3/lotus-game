pipeline {
    agent any

    environment {
        API_KEY_BROWSER = credentials('firebase-api-key-browser')
        API_KEY_ANDROID = credentials('firebase-api-key-android')
        API_KEY_IOS = credentials('firebase-api-key-ios')
        API_KEY_MACOS = credentials('firebase-api-key-macos')
        API_KEY_WINDOWS = credentials('firebase-api-key-windows')
        FIREBASE_TOKEN = credentials('firebase-token')
    }

    stages {
        stage('Setup Environment') {
            steps {
                sh '''
                    echo "API_KEY_BROWSER=${API_KEY_BROWSER}" > .env
                    echo "API_KEY_ANDROID=${API_KEY_ANDROID}" >> .env
                    echo "API_KEY_IOS=${API_KEY_IOS}" >> .env
                    echo "API_KEY_MACOS=${API_KEY_MACOS}" >> .env
                    echo "API_KEY_WINDOWS=${API_KEY_WINDOWS}" >> .env
                    echo "Contenu du .env:"
                    cat .env
                    
                    echo "Vérification des fichiers du projet:"
                    ls -la
                    
                    # Créer un Dockerfile simple si non présent
                    if [ ! -f Dockerfile ]; then
                        echo "Création d\'un Dockerfile simple..."
                        cat > Dockerfile << 'EOF'
FROM instrumentisto/flutter:3.41.4

# Installer Node.js 20 directement (plus simple)
RUN apt-get update && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g firebase-tools && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pubspec.yaml ./
RUN flutter pub get

COPY . .

RUN echo "API_KEY_BROWSER=${API_KEY_BROWSER}" >> .env
RUN echo "API_KEY_ANDROID=${API_KEY_ANDROID}" >> .env
RUN echo "API_KEY_IOS=${API_KEY_IOS}" >> .env
RUN echo "API_KEY_MACOS=${API_KEY_MACOS}" >> .env
RUN echo "API_KEY_WINDOWS=${API_KEY_WINDOWS}" >> .env

CMD ["tail", "-f", "/dev/null"]
EOF
                    fi
                    
                    echo "Contenu du Dockerfile:"
                    cat Dockerfile
                '''
            }
        }

        stage('Build Flutter Docker') {
            steps {
                sh '''
                    echo "Construction de l\'image Docker Flutter..."
                    docker build --no-cache -t flutter-builder .
                    
                    echo "Lancement du build dans le container Docker..."
                    docker run --rm \
                        -v $(pwd)/build:/app/build \
                        flutter-builder \
                        sh -c "
                            flutter pub get &&
                            flutter analyze --no-fatal-infos &&
                            flutter build web --release
                        "
                '''
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'web/**', fingerprint: true
            }
        }

        stage('Deploy Firebase') {
            steps {
                sh '''
                    docker run --rm \
                        -v $(pwd):/workspace \
                        -w /workspace \
                        -e FIREBASE_TOKEN=${FIREBASE_TOKEN} \
                        flutter-builder \
                        sh -c "
                            firebase deploy --only hosting --token \${FIREBASE_TOKEN}
                        "
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Build et déploiement réussis!'
        }
        failure {
            echo 'Échec du build ou du déploiement'
        }
    }
}
