{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lotus-418f7",
          "appId": "1:256451027870:android:f4228f3c871fd6894f2c8f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "lotus-418f7",
          "configurations": {
            "android": "1:256451027870:android:f4228f3c871fd6894f2c8f",
            "ios": "1:256451027870:ios:20a28817285580294f2c8f",
            "macos": "1:256451027870:ios:20a28817285580294f2c8f",
            "web": "1:256451027870:web:795b1820784ef1164f2c8f",
            "windows": "1:256451027870:web:8f92f242957797074f2c8f"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}